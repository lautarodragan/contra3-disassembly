# The sequences of the sounds that live in the sound driver (spc_driver.s
# includes this file; book: Sound driver). `sound_NN:` is the header of sound
# $NN (one sequence address per channel), which the driver's sound_table points
# to; `sound_NN_chK` its channels' sequences. Same syntax as the songs. They may
# change size: the labels follow, up to $3000 (the song of the set).
at $1B37

# sound $01, SOUND_CURSOR: a menu cursor moves (title menu, OPTION, CONTINUE, stage select, top-down start positions)
sound_01:
	song sound_01_ch0
sound_01_ch0:
	tempo $64
	inst $06
	channel_volume $41
	note $2F $08 $65 $5A
	slide $00 $05 $40
	note $34 . . $19
	slide $00 $05 $40
	note $34 . . $0F
	slide $00 $05 $40
	note $34 $0A . $08
	slide $00 $05 $40
	end

# sound $02, SOUND_SELECT: a menu choice is confirmed (title menu, OPTION, CONTINUE, top-down start positions)
sound_02:
	song sound_02_ch0
sound_02_ch0:
	tempo $78
	inst $06
	channel_volume $41
	repeat_start
	note $3C $05 $65 $5A
	note $37 . . $50
	note $40 . . $5A
	note $3C . . $50
	note $43 . . $5A
	note $40 . . $50
	note $48 . . $5A
	note $43 . . $50
	repeat
	channel_volume $10
	repeat
	channel_volume $07
	repeat
	end

# sound $03, SOUND_BONUS_COUNT: stage clear screen: each step of the bonus count (stage_clear_count_bonus)
sound_03:
	song sound_03_ch0
sound_03_ch0:
	tempo $78
	inst $06
	channel_volume $3C
	repeat_start
	note $3C $02 $65 $46
	note $41 . . $50
	note $43 . . $50
	note $45 . . $50
	note $48 . . $50
	repeat
	channel_volume $26
	repeat
	channel_volume $11
	repeat
	channel_volume $0A
	repeat
	channel_volume $06
	repeat
	end

