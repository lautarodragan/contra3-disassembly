	channel_volume $50
	vibrato $00 $BE $C8
	pan $00
	transpose $00
	loop1_start
	note $24 $0A $63 $7F
	note $26 $0F . $7F
	note $1D $14 . $7F
	note $21 $0F . $7F
	loop1 $08 $F1 $00
	end

