  60  OBJT_WEAPON_CAPSULE                  272    96  0001  280-300  # flying weapon capsule
  80  OBJT_WALL_WORM                       128   384  0100  900-940
  80  OBJT_BG1_AUTOSCROLL_TRIGGER            0     0  0000  9C0-AC0  # stage trigger: turns bg1_autoscroll on (update_bg1_autoscroll_trigger)
  end

