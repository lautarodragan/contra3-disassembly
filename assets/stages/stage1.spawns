  70  OBJT_GRENADE_SOLDIER                 256   200  0000  300-780  # stage 1: soldier throwing grenades (type $13), HP 6
  80  OBJT_WEAPON_CAPSULE                  272    96  0007  300-780  # flying weapon capsule
  A0  OBJT_SOLDIER_SPAWNER                   0     0  0000  780-840  # invisible: sends foot soldiers in from the screen edges
  end

