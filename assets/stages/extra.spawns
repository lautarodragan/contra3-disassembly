  30  OBJT_ALIEN_DOG                       256   190  0000  280-300  # alien dog (stage 1)
  50  OBJT_WINDOW_SNIPER                   256    72  0000  300-740  # sniper in a window (stages 1, 3)
  E0  OBJT_POPUP_TURRET                    256   200  0002  780-840  # gun turret rising from the rubble (stage 1)
  end

